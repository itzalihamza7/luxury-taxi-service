# Settings for running the API on its own (outside DDEV and Docker Compose).
# In DDEV these come from .ddev/config.yaml; in Docker Compose from the root .env file.

DATABASE_URL=postgresql://user:password@localhost:5432/luxury_taxi

# Public address of the website (used for payment return links).
APP_URL=http://localhost:3000

# Optional: created on start if it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Address search (Photon-compatible). Leave empty to use only the built-in list of places.
GEOCODER_URL=https://photon.komoot.io
# Road distances (OSRM-compatible server). Leave empty to estimate from straight-line distance.
ROUTER_URL=

# PayPal Checkout. Online payment is offered only when both are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default; use https://api-m.paypal.com for live payments.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
