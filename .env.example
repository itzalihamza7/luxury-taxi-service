# Settings for `docker compose`. Copy this file to `.env` and adjust the values.
# (DDEV does not use this file - its development settings live in .ddev/config.yaml.)

# --- Required -----------------------------------------------------------------

# Database password. Use letters and digits only: it becomes part of a connection URL.
POSTGRES_PASSWORD=

# Operator account for the bookings console at /admin. Created on first start.
ADMIN_EMAIL=
# At least 8 characters.
ADMIN_PASSWORD=

# --- Address of the site ------------------------------------------------------

# Public address, without a trailing slash. Use the real domain in production
# (for example https://www.example.com) and rebuild after changing it:
# it is written into canonical links, the sitemap and payment return links.
SITE_URL=http://localhost:3000

# Port the site is published on, on this machine.
APP_PORT=3000

# Number of proxies in front of the API. 1 = just the website (the default).
# Use 2 when a reverse proxy or load balancer sits in front of the website,
# so rate limits apply to the visitor's address rather than the proxy's.
TRUST_PROXY=1

# --- Optional services --------------------------------------------------------

# Address search (a Photon-compatible geocoder). The public Photon service is fine
# for light use; run your own instance for a busy site. Set to empty to disable.
GEOCODER_URL=https://photon.komoot.io

# Road distances from an OSRM-compatible routing server (for example your own
# OSRM instance). Empty = distances are estimated from straight-line distance.
ROUTER_URL=

# PayPal Checkout (card or PayPal). Online payment appears at checkout only when
# both values are set. Get them at https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox by default. For real payments: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
